<?xml version="1.0"?>
<ruleset name="BM S3 Offload">
	<description>Coding standard for BM S3 Offload.</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="minimum_wp_version" value="6.2"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress">
		<!-- PSR-4 class files (includes/Foo/Bar.php) instead of class-foo.php. -->
		<exclude name="WordPress.Files.FileName"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="bm-s3-offload"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="bms3o"/>
				<element value="BahrMedia\S3Offload"/>
			</property>
		</properties>
	</rule>

	<!--
		Exception messages of the S3 client are never printed raw: every place that
		displays them escapes the output (esc_html, textContent in JS).
	-->
	<rule ref="WordPress.Security.EscapeOutput.ExceptionNotEscaped">
		<exclude-pattern>/includes/S3/*</exclude-pattern>
	</rule>

	<rule ref="PHPCompatibilityWP"/>
</ruleset>
