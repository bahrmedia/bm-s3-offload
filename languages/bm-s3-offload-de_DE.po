msgstr "Fehler beim Synchronisieren von %s"

#: includes/Media/Attachments.php:252
msgid "Files in protected directories (BuddyBoss, WooCommerce, Easy Digital Downloads) cannot be made public."
msgstr "Dateien in geschützten Verzeichnissen (BuddyBoss, WooCommerce, Easy Digital Downloads) können nicht öffentlich gemacht werden."

#: includes/Offloader.php:822
#: includes/Offloader.php:829
msgid "Configuration"
msgstr "Konfiguration"

#: includes/Offloader.php:822
msgid "Endpoint, bucket, access key and secret key are required."
msgstr "Endpoint, Bucket, Access Key und Secret Key sind erforderlich."

#: includes/Offloader.php:841
#: includes/Offloader.php:843
