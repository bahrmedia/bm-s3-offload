msgstr "Öffentliche Auslieferung"

#. translators: 1: HTTP status, 2: URL
#: includes/Offloader.php:869
#, php-format
msgid "HTTP %1$s for %2$s – make the object prefix publicly readable (bucket policy) or enable signed URLs for all files."
msgstr "HTTP %1$s für %2$s – das Objekt-Präfix öffentlich lesbar machen (Bucket-Policy) oder signierte URLs für alle Dateien aktivieren."

#: includes/Offloader.php:879
msgid "Private objects are protected"
msgstr "Private Objekte sind geschützt"

#. translators: %s: HTTP status
#: includes/Offloader.php:883
#, php-format
msgid "Anonymous request returned HTTP %s. Private files are publicly readable – restrict the bucket policy to the public prefix."
msgstr "Ein anonymer Abruf lieferte HTTP %s. Private Dateien sind öffentlich lesbar – die Bucket-Policy auf das öffentliche Präfix beschränken."

#: includes/Offloader.php:897
msgid "Signed URLs"
msgstr "Signierte URLs"

#: includes/Offloader.php:900
msgid "Delete"
