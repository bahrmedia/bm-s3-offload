msgstr "Status"

#: includes/Admin/SettingsPage.php:435
msgid "Offloaded files"
msgstr "Ausgelagerte Dateien"

#: includes/Admin/SettingsPage.php:436
msgid "Size in bucket"
msgstr "Größe im Bucket"

#: includes/Admin/SettingsPage.php:437
msgid "Without local copy"
msgstr "Ohne lokale Kopie"

#: includes/Admin/SettingsPage.php:438
msgid "Private files"
msgstr "Private Dateien"

#: includes/Admin/SettingsPage.php:439
msgid "Waiting for retry"
msgstr "Warten auf erneuten Versuch"

#: includes/Admin/SettingsPage.php:443
msgid "Connection test"
msgstr "Verbindungstest"

#: includes/Admin/SettingsPage.php:444
msgid "Uploads, reads and deletes a small test file and checks public and private delivery."
msgstr "Lädt eine kleine Testdatei hoch, liest und löscht sie und prüft die öffentliche und private Auslieferung."

#: includes/Admin/SettingsPage.php:445
msgid "Run connection test"
msgstr "Verbindungstest starten"

#: includes/Admin/SettingsPage.php:448
msgid "Bulk operations"
msgstr "Massenverarbeitung"

#: includes/Admin/SettingsPage.php:449
msgid "Run an operation in this browser window (keep the page open) or in the background (WP-Cron; you can close the page). For very large libraries, WP-CLI is fastest: wp bm-s3"
msgstr "Die Verarbeitung läuft entweder in diesem Browserfenster (Seite geöffnet lassen) oder im Hintergrund (WP-Cron; die Seite darf geschlossen werden). Für sehr große Mediatheken ist WP-CLI am schnellsten: wp bm-s3"

#: includes/Admin/SettingsPage.php:458
#: includes/Admin/SettingsPage.php:634
msgid "Offload existing media"
msgstr "Vorhandene Medien auslagern"

#: includes/Admin/SettingsPage.php:458
msgid "Uploads all media that are not in the bucket yet."
msgstr "Lädt alle Medien hoch, die noch nicht im Bucket sind."

#: includes/Admin/SettingsPage.php:459
msgid "Deletes local copies of offloaded media after verifying each object in the bucket."
msgstr "Löscht die lokalen Kopien ausgelagerter Medien, nachdem jedes Objekt im Bucket geprüft wurde."

#: includes/Admin/SettingsPage.php:460
#: includes/Admin/SettingsPage.php:636
msgid "Restore local copies"
msgstr "Lokale Kopien wiederherstellen"

#: includes/Admin/SettingsPage.php:460
msgid "Downloads all files that only exist in the bucket back to this server."
msgstr "Lädt alle Dateien, die nur noch im Bucket liegen, zurück auf diesen Server."

#: includes/Admin/SettingsPage.php:462
#: includes/Admin/SettingsPage.php:637
msgid "BuddyBoss avatars and covers"
msgstr "BuddyBoss-Profil- und Titelbilder"

#: includes/Admin/SettingsPage.php:462
msgid "Mirrors all existing member and group avatars and cover images to the bucket."
msgstr "Spiegelt alle vorhandenen Profil-, Gruppen- und Titelbilder in den Bucket."

#: includes/Admin/SettingsPage.php:464
#: includes/Admin/SettingsPage.php:638
msgid "Leave the bucket"
msgstr "Bucket verlassen"

#: includes/Admin/SettingsPage.php:464
msgid "Restores every file locally and deletes it from the bucket. Use this before switching providers or uninstalling."
msgstr "Stellt jede Datei lokal wieder her und löscht sie aus dem Bucket. Vor einem Anbieterwechsel oder der Deinstallation verwenden."

#: includes/Admin/SettingsPage.php:468
msgid "Bucket policy"
msgstr "Bucket-Policy"

#: includes/Admin/SettingsPage.php:469
msgid "Example policy that makes only the public prefix readable. Private files and everything else stay protected."
msgstr "Beispiel-Policy, die nur das öffentliche Präfix lesbar macht. Private Dateien und alles andere bleiben geschützt."

